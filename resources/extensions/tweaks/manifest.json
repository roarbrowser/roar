{
  "manifest_version": 3,
  "name": "Site tweaks",
  "version": "1.0.0",
  "description": "Roar's userscript and userstyle manager.",
  "key": "",
  "minimum_chrome_version": "138",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["webRequest", "userScripts", "storage", "unlimitedStorage", "tabs", "alarms", "downloads", "notifications", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "options_page": "manage.html",
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "declarative_net_request": { "rule_resources": [{ "id": "install", "enabled": true, "path": "rules.json" }] },
  "web_accessible_resources": [{ "resources": ["install.html"], "matches": ["<all_urls>"] }]
}
