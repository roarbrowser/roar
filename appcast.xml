      <sparkle:shortVersionString>1.7.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent headless launches no longer open a stray about:blank tab.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.1/Roar-1.7.1.dmg" type="application/octet-stream" sparkle:edSignature="i2QIaA2j0LWi+Q6norHEjjF5zL6iOYnMXihBFqGvM7txi5Bk0Hx5+IHuRyP3AElS0Bo+6yuxt2REIci9kbSyCg==" length="207656594"/>
