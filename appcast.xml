    <item>
      <title>1.7.4</title>
      <pubDate>Mon, 02 Nov 2026 14:36:14 +0000</pubDate>
      <sparkle:version>10704</sparkle:version>
      <sparkle:shortVersionString>1.7.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Roar writes about 10 times less to disk: history now has its own file, and history and saved page text are written every few minutes instead of on every page change.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.4/Roar-1.7.4.dmg" type="application/octet-stream" sparkle:edSignature="6zqSpmRLSvqKZ+lWpoXqTqjhOkt4ISatIIyXOd0Z7NvSm1K2oa6otVMdY9sknX1yCAZq6BXqtbIFVqKF9SorDA==" length="207665060"/>
