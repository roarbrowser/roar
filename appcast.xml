    <item>
      <title>0.18.2</title>
      <pubDate>Sat, 17 Oct 2026 02:53:43 +0000</pubDate>
      <sparkle:version>1802</sparkle:version>
      <sparkle:shortVersionString>0.18.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Roar is now notarized by Apple: it opens on the first launch without a trip to Privacy & Security.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.18.2/Roar-0.18.2.dmg" type="application/octet-stream" sparkle:edSignature="FTUhy69CdNLOpMuDQVrFJwgeHPw8IFgEEiP6XkT5CKof3/k3btsUMfksYgqekou2TKa5Z1GOpOzFf+PBwLrWBQ==" length="234946845"/>
