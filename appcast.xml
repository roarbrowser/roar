    <item>
      <title>1.5.6</title>
      <pubDate>Mon, 26 Oct 2026 01:45:37 +0000</pubDate>
      <sparkle:version>10506</sparkle:version>
      <sparkle:shortVersionString>1.5.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Claude Code's background spare processes no longer show up as stuck agent sessions. Ending a session removes it once the agent has fully stopped. The Outlook and Gmail buttons have different icons. Bigger text no longer lets the chat scroll below the message box.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.6/Roar-1.5.6.dmg" type="application/octet-stream" sparkle:edSignature="ZqUzDxVUgLCM3QcoyFiK1xfR7R8STLEQWt1PMN/eXbQVaGh70jDk66ZeAPXFAwjIv6N8SBlHGeYM1DMdNSBtAQ==" length="207617755"/>
    </item>
    <item>
      <title>1.6.0</title>
      <pubDate>Mon, 26 Oct 2026 02:06:02 +0000</pubDate>
      <sparkle:version>10600</sparkle:version>
      <sparkle:shortVersionString>1.6.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[New Agents board (from the AI header) shows every agent, what it's doing, the helpers and commands it has running, and the tabs it holds. The agent chat shows running helpers. Agents' tabs now close two minutes after the agent finishes its turn, unless it starts again.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.6.0/Roar-1.6.0.dmg" type="application/octet-stream" sparkle:edSignature="4mkb+KmqvQUXh/JDKKMXZfshU/geaGn/3uBh14A/fC1MNcZDmn12Q77cZ6WHpMOjciAWWTkXnYRr38TkxCYNCA==" length="207645129"/>
    </item>
    <item>
      <title>1.6.1</title>
      <pubDate>Mon, 26 Oct 2026 02:41:26 +0000</pubDate>
      <sparkle:version>10601</sparkle:version>
      <sparkle:shortVersionString>1.6.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Pasting an image into an agent now sends it. Cmd+ and Cmd- change text size in the AI windows. In the terminal view, arrow keys, Enter, Esc, Tab and Ctrl-C reach the agent without clicking the terminal first. Wide tables wrap. Split ghost tabs stay under Ghost.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.6.1/Roar-1.6.1.dmg" type="application/octet-stream" sparkle:edSignature="QQfPLQQVC/B/NofK7HRYSJaFHB91C2chGXpl+A8e8w8n95VX7dei0RtPkLoonOprxEMFUPgCcJwz3v4YtNa+Bw==" length="207646388"/>
    </item>
    <item>
      <title>1.6.2</title>
      <pubDate>Mon, 26 Oct 2026 03:06:38 +0000</pubDate>
      <sparkle:version>10602</sparkle:version>
      <sparkle:shortVersionString>1.6.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[In the agent's terminal view you now type straight into the terminal, like a real one: every key, paste and pasted images go to the agent. The sidebar's End button works (click it twice). Questions an agent asks now show up in the agent view.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.6.2/Roar-1.6.2.dmg" type="application/octet-stream" sparkle:edSignature="DsrwNF1e4mqW81jzXuM52jkI4ICDjfa6RkqESStnIeKckd7r5CE0P2R06tiH09EqHmtrIF3+EQdAVdadMWi/DQ==" length="207647247"/>
    </item>
    <item>
      <title>1.6.3</title>
      <pubDate>Thu, 29 Oct 2026 00:18:47 +0000</pubDate>
      <sparkle:version>10603</sparkle:version>
      <sparkle:shortVersionString>1.6.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[⌘N opens a new window in the same Roar, so it shares your sign-ins live. ⇧⌘W closes just that window, and each tab's window is remembered across restarts.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.6.3/Roar-1.6.3.dmg" type="application/octet-stream" sparkle:edSignature="XKZ4vkaFafntIvjzxDCh67tgLOa0TCPG3Lt+3auZVf6N9JdJCqjAlhmBMlkrbwdKyV4xSuoDxPARcTpm4Ru9Aw==" length="207640986"/>
