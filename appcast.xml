      <sparkle:shortVersionString>1.7.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Fixes a crash when you chose Stay on a page's "Leave site?" dialog, such as when leaving an unsent email.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.3/Roar-1.7.3.dmg" type="application/octet-stream" sparkle:edSignature="USlr5c48/9sX0SjlJ1K/wOM5FcI0g37jepMBXYvVJ+4leNADP88au2vIL9FrQKoxII0hiL2EgspRYltpGJMZDw==" length="207664619"/>
