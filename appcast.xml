      <sparkle:shortVersionString>1.7.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Headless mode for agents now stays fully in the background: no Roar window appears at launch or when agents open pages, popups or windows. Pick Show Roar in the menu bar icon to see it.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.2/Roar-1.7.2.dmg" type="application/octet-stream" sparkle:edSignature="vzkLl+0p5E1EtRE87SU9F8zk7SgFJdlmopvt1zRNUvZKx0pilcY8IoHBHJhpWY0BPP98TMMqmaiyuaeupzmRBg==" length="207661149"/>
