    <title>Roar</title>
    <item>
      <title>1.3.0</title>
      <pubDate>Sat, 24 Oct 2026 13:22:55 +0000</pubDate>
      <sparkle:version>10300</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Intel Macs are now supported. CDP connections need a per-launch token on Apple Silicon (Intel in 1.4). Agents can only act on their own tabs. Popups and extension windows stay in their own space. A missing space 0 in state.json is repaired. Accessibility contrast and focus fixes. Clearer privacy disclosures and third-party notices. Windows preview.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.3.0/Roar-1.3.0.dmg" type="application/octet-stream" sparkle:edSignature="HUAZNHgiAXpwN4/ueKqcNUwE11yi34q4qsP+uYiDfVl+YYP8y+chlp+diLPmHPAfmQTKrmRpXE4zhNd79EIjDw==" length="207615868"/>
    </item>
    <item>
      <title>1.3.1</title>
      <pubDate>Sun, 25 Oct 2026 10:49:20 +0000</pubDate>
      <sparkle:version>10301</sparkle:version>
      <sparkle:shortVersionString>1.3.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[- Intel Macs now get the agent access token.
- Pages agents leave open now appear as tabs instead of hiding.
- Verification codes can now fill from Gmail as well as Apple Mail.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.3.1/Roar-1.3.1.dmg" type="application/octet-stream" sparkle:edSignature="apFNjZEcM4PTjoXLlt9hJzLuSD4HvflqoyH341Yk2UQ/2Iw89fzft6KNfmgU+mVYxvhuZAeHETSQ9xlcycWJCw==" length="207620624"/>
    </item>
    <item>
      <title>1.3.2</title>
      <pubDate>Sun, 25 Oct 2026 13:29:30 +0000</pubDate>
      <sparkle:version>10302</sparkle:version>
      <sparkle:shortVersionString>1.3.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Settings: API keys and local servers now sit in a collapsed section.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.3.2/Roar-1.3.2.dmg" type="application/octet-stream" sparkle:edSignature="uWEGIsPgrPpVVRLSXFiT+Ta0Pvuf6ij+cH2PV1rcJti/V16KmnvFEra/9FKp91HqaHINxpwX3QsLzP/JaVy5Ag==" length="207620772"/>
    </item>
    <item>
      <title>1.4.0</title>
      <pubDate>Sun, 25 Oct 2026 15:47:02 +0000</pubDate>
      <sparkle:version>10400</sparkle:version>
      <sparkle:shortVersionString>1.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Send Diagnostics: Roar > Send Diagnostics… (Mac) and Settings > Send diagnostics (Mac and Windows) email Roar's error log with web addresses and your user folder removed. Ask: a signed-out Claude now says to run claude in Terminal and /login there.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.4.0/Roar-1.4.0.dmg" type="application/octet-stream" sparkle:edSignature="BOVB08xGxnHADHqtF58vAdNaXl7OsGhUM6+IkthVKcSN9o7yo9rBgGJ7nsxeY3lKcOOpJ2WrAZRJowTlcCpQBA==" length="207610387"/>
    </item>
    <item>
      <title>1.5.0</title>
      <pubDate>Sun, 25 Oct 2026 16:56:05 +0000</pubDate>
      <sparkle:version>10500</sparkle:version>
      <sparkle:shortVersionString>1.5.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Sign in from Roar: when Claude Code or Codex in Ask isn't signed in, a Sign in button runs its sign-in page in Roar and then asks your question again. Settings > Agents has the same button.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.0/Roar-1.5.0.dmg" type="application/octet-stream" sparkle:edSignature="zHoxsDVFq1FZKHPLknNVO7/w0zQYRKLzOGC3HVtz6CZCzFR/L5zzpQG4cxHperElEB0j2SgnccZ0vog9IP8ZBg==" length="207610688"/>
    </item>
    <item>
      <title>1.5.1</title>
      <pubDate>Sun, 25 Oct 2026 23:30:28 +0000</pubDate>
      <sparkle:version>10501</sparkle:version>
      <sparkle:shortVersionString>1.5.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent chat now shows the messages you send. Click the terminal view to drive the agent with arrow keys, Enter, Esc and Tab. With dictation on, the Ask and agent tabs have a mic button; hover it for the shortcut. Ask and agent chat render Markdown tables.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.1/Roar-1.5.1.dmg" type="application/octet-stream" sparkle:edSignature="lkdgZCxLVpIKxYKzh0rW8WJD6AgRIHsN6ZRoXko9PqPkBF4n6FNfFTPqpUZGb26DMDn1A7JAMyyIg4wUIGr5DA==" length="207618121"/>
    </item>
    <item>
      <title>1.5.2</title>
      <pubDate>Sun, 25 Oct 2026 23:52:46 +0000</pubDate>
      <sparkle:version>10502</sparkle:version>
      <sparkle:shortVersionString>1.5.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Ask has a refresh button beside the model picker, so newly started model servers and new keys show up without reopening the tab. Agent cards that need you now have a Reply button.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.2/Roar-1.5.2.dmg" type="application/octet-stream" sparkle:edSignature="XwvJzgiJn+F3NeT0upltw8sZZmtQv+Moz3DF8qggKHIe6tWmOs51KSVQssjGIFtyvbayNh2w9Ft/AWrRqUZ9Bg==" length="207618237"/>
    </item>
    <item>
      <title>1.5.3</title>
      <pubDate>Mon, 26 Oct 2026 00:21:06 +0000</pubDate>
      <sparkle:version>10503</sparkle:version>
      <sparkle:shortVersionString>1.5.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent rows in the sidebar now show their state in color: green working, orange needs you, a ring when done; a session's own color is a bar on its edge. Renaming an agent session in Roar now renames it in Claude Code too. The AI section can rename every session at once and has a refresh button, and live sessions have an End button.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.3/Roar-1.5.3.dmg" type="application/octet-stream" sparkle:edSignature="FjjARuqUU/kH9bwfzlBfGgw7YdFxtJplhqDy3FG30w6UuCwny7+m4RsxwPGhvVVbqoqLxNoAKOmDcnSu3siPBw==" length="207619506"/>
    </item>
    <item>
      <title>1.5.4</title>
      <pubDate>Mon, 26 Oct 2026 00:45:31 +0000</pubDate>
      <sparkle:version>10504</sparkle:version>
      <sparkle:shortVersionString>1.5.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[The agent terminal view now shows the whole screen: the agent's terminal takes the size of the view instead of a fixed 80 by 24, and long output is no longer cut off.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.4/Roar-1.5.4.dmg" type="application/octet-stream" sparkle:edSignature="bN4p0KIX9Qht3yMeTxM4/co2fTsuyE2780x2Itw0YPZlJDxeJxjKsyMwW49RFZp7gRuEpenFFKt7oXSyoOixAQ==" length="207620398"/>
    </item>
    <item>
      <title>1.5.5</title>
      <pubDate>Mon, 26 Oct 2026 01:14:02 +0000</pubDate>
      <sparkle:version>10505</sparkle:version>
      <sparkle:shortVersionString>1.5.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[The agent view and the Ask tab have text size buttons (A− and A+, or Cmd+ and Cmd−) for the terminal and the chat; the size is shared across AI windows.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.5/Roar-1.5.5.dmg" type="application/octet-stream" sparkle:edSignature="MIRrDvQGIlyZABiKCh5HJ03rx1h+QZNDKDgeyibWajcIkL1hA+FuCUXNeuLCHZ27aNMrouI4JRKY40yIWSRoAg==" length="207616978"/>
    </item>
    <item>
      <title>1.5.6</title>
      <pubDate>Mon, 26 Oct 2026 01:45:37 +0000</pubDate>
      <sparkle:version>10506</sparkle:version>
      <sparkle:shortVersionString>1.5.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Claude Code's background spare processes no longer show up as stuck agent sessions. Ending a session removes it once the agent has fully stopped. The Outlook and Gmail buttons have different icons. Bigger text no longer lets the chat scroll below the message box.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.5.6/Roar-1.5.6.dmg" type="application/octet-stream" sparkle:edSignature="ZqUzDxVUgLCM3QcoyFiK1xfR7R8STLEQWt1PMN/eXbQVaGh70jDk66ZeAPXFAwjIv6N8SBlHGeYM1DMdNSBtAQ==" length="207617755"/>
