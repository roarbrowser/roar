    <item>
      <title>0.19.0</title>
      <pubDate>Sat, 17 Oct 2026 03:00:52 +0000</pubDate>
      <sparkle:version>1900</sparkle:version>
      <sparkle:shortVersionString>0.19.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions now tell you in the sidebar when a session needs you or finishes, not only with a macOS notification while Roar is in the background. Disconnecting a CLI in Settings hides its sessions right away. If a CLI on your Mac isn't connected, or its hooks point at an old copy of Roar, a card says so with Connect, Snooze a day and Don't remind me. The full session view has a Send now key for messages Claude Code has queued.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.19.0/Roar-0.19.0.dmg" type="application/octet-stream" sparkle:edSignature="CMrd+0u8b9FgpeIY+fkwmp7zR/gOYkKoW5miUX1LWTBmVE7BmAAXixJBX7Lp/tQEd94SFdwe++Z1Ky6NMl/pCg==" length="234948393"/>
    </item>
    <item>
      <title>0.20.0</title>
      <pubDate>Sat, 17 Oct 2026 03:04:35 +0000</pubDate>
      <sparkle:version>2000</sparkle:version>
      <sparkle:shortVersionString>0.20.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Side by side: put an agent session next to the web page you're on, from the split icon on its row or the button in its full view. In the full view, clicking the terminal screen or just starting to type puts you in the reply box.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.20.0/Roar-0.20.0.dmg" type="application/octet-stream" sparkle:edSignature="V2diUxpoC5nrm33DiiZX/8whJMJdlAeBAQr1AAJE71zCuObS9GA2QBZ8OuAwfoUeumTU4zu192050CP5C6joAQ==" length="234949870"/>
    </item>
    <item>
      <title>0.20.1</title>
      <pubDate>Sat, 17 Oct 2026 03:20:22 +0000</pubDate>
      <sparkle:version>2001</sparkle:version>
      <sparkle:shortVersionString>0.20.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Fix: closing a tab with a "Leave site?" prompt left an orphaned window and could take Roar down. Agents connected through the Roar MCP server now know to use Roar for web tasks without being told.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.20.1/Roar-0.20.1.dmg" type="application/octet-stream" sparkle:edSignature="dm4mRs5omKdXCDUBWniRvHl0hCrQRBtOnONyLOZiN4Q+kAVt2ojREbBVnT2QTA3WY6kNsYZw6Yr/WHATWGicDQ==" length="234952801"/>
    </item>
    <item>
      <title>0.20.2</title>
      <pubDate>Sat, 17 Oct 2026 03:23:40 +0000</pubDate>
      <sparkle:version>2002</sparkle:version>
      <sparkle:shortVersionString>0.20.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Done cards from agents clear themselves after 30 seconds. Agent notifications are cleaned up: no code blocks, markdown or long encoded strings. A session's terminal view now scales to fit, so it reads properly side by side.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.20.2/Roar-0.20.2.dmg" type="application/octet-stream" sparkle:edSignature="Fu3J8PqYFRc1SOoWSwtEfpuulQyE/2JPUKgYtaam2bVKOeQnlc0X3HicekduJ2jZ/bVNOIYQhx2FWBXZEf8ACg==" length="234953522"/>
    </item>
