      <sparkle:version>10700</sparkle:version>
      <sparkle:shortVersionString>1.7.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Nested tab groups, Rename… for tabs that keeps the name across navigation, an emoji icon for each space, air traffic control (links from other apps open in the space you choose), and a one-click Copy URL button in the address bar.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.0/Roar-1.7.0.dmg" type="application/octet-stream" sparkle:edSignature="/PUC1EWi39ht3q9t6tuDnsp0uXp7y9wgwMMePCDfoOSn0MLt7P/0RWm5x4GSu46aMHTYQYuRDbCQ6BwW0DZCDQ==" length="207665484"/>
