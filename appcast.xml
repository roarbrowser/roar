      <sparkle:shortVersionString>1.7.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[A space where agents are allowed now shows a small green light on its dot instead of a ring, so it no longer looks like the space you're on.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.6/Roar-1.7.6.dmg" type="application/octet-stream" sparkle:edSignature="NYp62xIY1WONfa7/B0YSuTqmCtgJPt8yCv5SxtW8aIh04X9Hh2+Ua7pm6YZU7hbbK7gNngmBnRIKek1dQpeGCQ==" length="207658565"/>
