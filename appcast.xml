    <item>
      <title>1.7.7</title>
      <pubDate>Mon, 02 Nov 2026 21:54:31 +0000</pubDate>
      <sparkle:version>10707</sparkle:version>
      <sparkle:shortVersionString>1.7.7</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[The space you're on now sits on a lit tile in the sidebar, so it's easy to spot.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v1.7.7/Roar-1.7.7.dmg" type="application/octet-stream" sparkle:edSignature="F3hDUMktjIYNLCv09mIqZVr2QTiHlnxR2ISOiKx0NK7zK78RDmUFjgZKnaciWQW2gjInXbwbfH45yYrVs6jnCQ==" length="207659042"/>
