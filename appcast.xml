    <title>Roar</title>
    <item>
      <title>0.9.0</title>
      <pubDate>Thu, 15 Oct 2026 16:47:02 +0000</pubDate>
      <sparkle:version>0.9.0</sparkle:version>
      <sparkle:shortVersionString>0.9.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Roar now lives at github.com/roarbrowser/roar. The bundle id is now com.roarbrowser.roar: macOS asks again for permissions such as Screen Recording, and older installs don't auto-update to this version, so download it once by hand.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.9.0/Roar-0.9.0.dmg" type="application/octet-stream" sparkle:edSignature="COwAzyK8DjMCA/Zpho/wntzXsxGsgDUs+P8J263tbLA/pDNQV5RfUawcgc7HzveHMyLBXPiCGMUlJ/VwpOHFDA==" length="182616408"/>
    </item>
    <item>
      <title>0.9.1</title>
      <pubDate>Thu, 15 Oct 2026 17:02:46 +0000</pubDate>
      <sparkle:version>0.9.1</sparkle:version>
      <sparkle:shortVersionString>0.9.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[New tagline: the AI-native, open-source browser your agent can drive (welcome page). README corrected and now lists Arc import, ghost tabs, new windows, pinned groups, link cleaning and auto-update.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.9.1/Roar-0.9.1.dmg" type="application/octet-stream" sparkle:edSignature="BNNcDCHN0iohaPbmWPw+QNygModKqA7V1rv4n/7Zcb/PmMusll9/FfPzmBRHNHjw9qkKoxrHk2AyfhDf4diXAg==" length="183678263"/>
    </item>
    <item>
      <title>0.10.0</title>
      <pubDate>Fri, 16 Oct 2026 11:13:58 +0000</pubDate>
      <sparkle:version>0.10.0</sparkle:version>
      <sparkle:shortVersionString>0.10.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Split view with per-pane back buttons; Claude Code sessions: full view, '+ This tab' sends the current page to a session (never ghost tabs), and a setting to show or hide sessions in the sidebar; new CLAUDE.md browser lists every CLAUDE.md, AGENTS.md, GEMINI.md and similar file in your home folder.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.10.0/Roar-0.10.0.dmg" type="application/octet-stream" sparkle:edSignature="uJd/pnbBQVj9WvQzlNw/oVcYYFVA1/+1wE4MtGDR5PTpEDxDlHqHw1NWOpeN8wji0ZCt+AoVIcYEqeyo0s4cBQ==" length="234882711"/>
    </item>
    <item>
      <title>0.11.0</title>
      <pubDate>Fri, 16 Oct 2026 19:49:26 +0000</pubDate>
      <sparkle:version>0.11.0</sparkle:version>
      <sparkle:shortVersionString>0.11.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Claude Code alerts: Roar shows a sidebar card when a session finishes or needs you, and Settings lets you pick which alerts you get (finished, needs you, macOS notification while Roar is in the background).]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.11.0/Roar-0.11.0.dmg" type="application/octet-stream" sparkle:edSignature="bw54i8NzSZ1EjYHfsB7JPiwetjW8jwdkG66QoJDbTkZ6J+Kp6OpnByk/PgH+pdouZ+X8wPodnP6dG91zEQ1xBg==" length="234886133"/>
    </item>
    <item>
      <title>0.12.0</title>
      <pubDate>Sat, 17 Oct 2026 00:39:03 +0000</pubDate>
      <sparkle:version>0.12.0</sparkle:version>
      <sparkle:shortVersionString>0.12.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions for Claude Code, Codex, Gemini CLI, Qwen Code and Copilot CLI with per-tool icons and alerts that clear themselves. New Settings page with categories and search, and a shorter first-run. Agent files sidebar module that finds and edits every major agent rules format. More chat apps in Ask an LLM. Security and accessibility fixes.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.12.0/Roar-0.12.0.dmg" type="application/octet-stream" sparkle:edSignature="no3IOvFnWMel2iF9R398ekB/zBQlqjYev7lAItwQorVHuMOnzkSZRp6Ixl+xtzONqWspMXgpTf9OjIYLq3Y3CQ==" length="234922112"/>
    </item>
    <item>
      <title>0.12.1</title>
      <pubDate>Sat, 17 Oct 2026 00:47:43 +0000</pubDate>
      <sparkle:version>0.12.1</sparkle:version>
      <sparkle:shortVersionString>0.12.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions popover: readable two-line rows, icon actions on hover, one reply box at a time. Fixes a file-save issue where a planted symlink could redirect an Agent files save.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.12.1/Roar-0.12.1.dmg" type="application/octet-stream" sparkle:edSignature="c5zOpp6SBmBomVWr1RmA35gPLV1X1izEY58PrmqxgWlW1hn3HES9hhEN9FkwM2xgX8xN894L9F7BDmWuwivwCQ==" length="234917511"/>
    </item>
    <item>
      <title>0.13.0</title>
      <pubDate>Sat, 17 Oct 2026 01:08:44 +0000</pubDate>
      <sparkle:version>0.13.0</sparkle:version>
      <sparkle:shortVersionString>0.13.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions: a visible Send tab button, pin sessions into their own sidebar section, start a chat with any installed agent without picking a folder, and start a session with the current page attached.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.13.0/Roar-0.13.0.dmg" type="application/octet-stream" sparkle:edSignature="w+j0EwoVuoi+ZMhXRxLM1Ziv6fe7K/DGRanGBGAbtl3N7Pln3ie3es9ayW9L9YegZUVJoltpZahq69KRU/ZJAQ==" length="234924426"/>
    </item>
    <item>
      <title>0.14.0</title>
      <pubDate>Sat, 17 Oct 2026 01:46:32 +0000</pubDate>
      <sparkle:version>0.14.0</sparkle:version>
      <sparkle:shortVersionString>0.14.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions are now one calm sidebar section above Tabs; the footer terminal button shows or hides it. Rows show only a Reply pill when a session needs you. New opens a dialog: pick the agent CLI, then a folder or a scratch folder, and an optional first prompt. Scratch sessions are named after their first prompt. Send tab lives in the section header.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.14.0/Roar-0.14.0.dmg" type="application/octet-stream" sparkle:edSignature="75jn62omFfExabzoDEr8NwTS8/Fgz0fNxi88NcLYZVlu7/0yvqEOcq53sfnGc8tEgTBHjJezfwyT9mF8UZQ5Dw==" length="234920656"/>
    </item>
    <item>
      <title>0.15.0</title>
      <pubDate>Sat, 17 Oct 2026 02:10:19 +0000</pubDate>
      <sparkle:version>0.15.0</sparkle:version>
      <sparkle:shortVersionString>0.15.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[New agent sessions can attach any open web tabs. Send tab now takes an optional prompt that's sent along with the page. Only the agent CLIs you connect in Settings > Agent sessions appear in New and Ask an Agent About This Page.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.15.0/Roar-0.15.0.dmg" type="application/octet-stream" sparkle:edSignature="CecrbE7ClPQZzG5xkN3LAEpK9ubJ5ZviNxUgyg4niKUoVGBObVgeH1nsCG4CffOwEcVE8stxyC+GYRGMpZX/Cg==" length="234994282"/>
    </item>
    <item>
      <title>0.15.1</title>
      <pubDate>Sat, 17 Oct 2026 02:11:32 +0000</pubDate>
      <sparkle:version>0.15.1</sparkle:version>
      <sparkle:shortVersionString>0.15.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions now sit below Tabs, and rows no longer flash: a session that needs you is a steady orange tint.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.15.1/Roar-0.15.1.dmg" type="application/octet-stream" sparkle:edSignature="u0BSdTi2f8eKV1CuiWI/yk4yKNn5oHOc0l/bQRuRfPYRtPrf+oEsUQSuYvUSxS0SogC1G14F4eqD9W4SwHPnAA==" length="234994210"/>
    </item>
    <item>
      <title>0.15.2</title>
      <pubDate>Sat, 17 Oct 2026 02:19:22 +0000</pubDate>
      <sparkle:version>0.15.2</sparkle:version>
      <sparkle:shortVersionString>0.15.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent sessions can be collapsed and expanded from the arrow beside its name; Roar remembers which.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.15.2/Roar-0.15.2.dmg" type="application/octet-stream" sparkle:edSignature="/44iQUE2hHvyKwW5ay0qIMOxX9bPvxVa+MNoDsaHh+5D6N3n/WQXmagBA6/hfWSkrWvx+Q4H8y6B8NKPtlauDg==" length="234994759"/>
    </item>
    <item>
      <title>0.15.3</title>
      <pubDate>Sat, 17 Oct 2026 02:24:31 +0000</pubDate>
      <sparkle:version>0.15.3</sparkle:version>
      <sparkle:shortVersionString>0.15.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent files now opens from the { } button in the Agent sessions header instead of its own footer icon. The header's Send tab is a paperclip, so everything fits on one line.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.15.3/Roar-0.15.3.dmg" type="application/octet-stream" sparkle:edSignature="10DH8brSKaNEu0KlrdfyWiOnCnNOc8QlR08Djr2DTEfLtwuZR8dw3mWGIH4nOoxhqLJ6+lHCdetezsNIs+sVCg==" length="234992268"/>
    </item>
    <item>
      <title>0.16.0</title>
      <pubDate>Sat, 17 Oct 2026 02:33:40 +0000</pubDate>
      <sparkle:version>0.16.0</sparkle:version>
      <sparkle:shortVersionString>0.16.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Settings has one Agents section: coding agents in your terminal, then agents that browse with Roar, with a plain choice of where agents browse and a switch for each space they can see. Clean links I copy now lets you choose what it removes: Safe Links, the .mcas.ms proxy, tracking parameters (utm_*, fbclid, gclid…) and your own list. Agent files is a row in Agent sessions.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.16.0/Roar-0.16.0.dmg" type="application/octet-stream" sparkle:edSignature="i0nolHofkFdjVzK+oGkq2kieM/UIJZ2ksIF8HOlNoGsKTUNG+xrKWMPgXN8Lbr7sjTc1BgILMwkus10T/QWqDw==" length="234995152"/>
    </item>
    <item>
      <title>0.17.0</title>
      <pubDate>Sat, 17 Oct 2026 02:37:25 +0000</pubDate>
      <sparkle:version>1700</sparkle:version>
      <sparkle:shortVersionString>0.17.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent files shows in Agent sessions by default; the { } button in its header hides or shows it. Settings > Updates lets you turn automatic update checks and automatic installs on or off. Fixes updates: earlier builds all carried build number 1, so Roar never saw a release as newer. This version is the first one Check for Updates can install.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.17.0/Roar-0.17.0.dmg" type="application/octet-stream" sparkle:edSignature="nWzvbphCCIvfCh6i0WcwXphLG94JKYE5WcIsG9ZKBrZVnjUyaNsCa/bnVvzrCtgpRCZNiC0owRpJXYKKpVjiBA==" length="235004426"/>
    </item>
    <item>
      <title>0.18.0</title>
      <pubDate>Sat, 17 Oct 2026 02:41:29 +0000</pubDate>
      <sparkle:version>1800</sparkle:version>
      <sparkle:shortVersionString>0.18.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Agent files groups files by project, so it's clear which repo each one belongs to (files in ~/.claude and similar show as Global). Filter by project, agent, and by when a file was changed, created or last opened, including stale files over 3 months or a year old. Tick files and move them to the Trash in one go; Finder's Put Back undoes it.]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.18.0/Roar-0.18.0.dmg" type="application/octet-stream" sparkle:edSignature="7s4kn9Ccuty3HjTKkl6MEJj589zxQN5ok7KKS9ncJchkRbYxbLCXhnPyX6snVHWZ2hDbiMY4bcF0XtP7UjuSCQ==" length="234996767"/>
    </item>
    <item>
      <title>0.18.1</title>
      <pubDate>Sat, 17 Oct 2026 02:49:58 +0000</pubDate>
      <sparkle:version>1801</sparkle:version>
      <sparkle:shortVersionString>0.18.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Signed with the company Developer ID (notarization follows in 0.18.2).]]></description>
      <enclosure url="https://github.com/roarbrowser/roar/releases/download/v0.18.1/Roar-0.18.1.dmg" type="application/octet-stream" sparkle:edSignature="MAhft6ESkyYxNRAGbw62W/220mrtY/P+i3hGX0f+AfsPWQLYna5YVcakkJHTz39vV0BUs4DzUI3WH0G8X66bAw==" length="234996536"/>
