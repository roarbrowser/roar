 struct InputData {
   raw_ptr<DecoderBuffer> buffer = nullptr;
   AudioStreamPacketDescription packet = {};
+  size_t skip = 0;  // Roar: ADTS header bytes to drop before the raw frame.
 };
+
+// Roar: the MSE MP4 parser (PrepareAACBuffer) and the MPEG-2 TS parser hand
+// AAC over with an ADTS header, but AudioConverter wants the raw access unit,
+// so return the header length to skip (0 if there is none).
+size_t AdtsHeaderSize(base::span<const uint8_t> data) {
+  if (data.size() < 7 || data[0] != 0xFF || (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t frame_length =
+      ((data[3] & 0x03u) << 11) | (data[4] << 3) | (data[5] >> 5);
+  if (frame_length != data.size()) {
+    return 0;  // Not exactly one ADTS frame, so treat it as raw AAC.
+  }
+  const size_t header = (data[1] & 0x01) ? 7 : 9;  // protection_absent: no CRC.
+  return header < data.size() ? header : 0;  // No payload: not ADTS.
+}
+
+// Roar: AudioToolbox plays a plain 2-byte AAC-LC AudioSpecificConfig at its
+// core rate. When Chromium inferred SBR from the codecs string (the config's
+// rate is twice the core rate, see mp4/aac.cc), append the backward-compatible
+// SBR signal, plus PS when a mono core plays as stereo (ISO/IEC 14496-3
+// 1.6.5.2), so that the FormatList query below offers the HE-AAC layer.
+std::vector<uint8_t> AddImplicitSbrSignal(const AudioDecoderConfig& config) {
+  std::vector<uint8_t> asc = config.extra_data();
+  if (asc.size() != 2 || (asc[0] >> 3) != 2) {  // Only plain AAC-LC.
+    return asc;
+  }
+  const size_t core =
+      static_cast<size_t>(((asc[0] & 0x07) << 1) | (asc[1] >> 7));
+  if (core < 3 || core >= kADTSFrequencyTable.size() ||
+      config.samples_per_second() != 2 * kADTSFrequencyTable[core]) {
+    return asc;
+  }
+  // syncExtensionType 0x2b7, AOT 5 (SBR), sbrPresentFlag 1, rate index.
+  uint64_t bits = (0x2b7u << 10) | (5u << 5) | (1u << 4) | (core - 3);
+  int count = 21;
+  if (((asc[1] >> 3) & 0x0F) == 1 &&
+      config.channel_layout() == CHANNEL_LAYOUT_STEREO) {
+    bits = (bits << 12) | (0x548u << 1) | 1u;  // PS sync word, psPresentFlag.
+    count += 12;
+  }
+  const int padded = (count + 7) / 8 * 8;
+  bits <<= padded - count;
+  for (int shift = padded - 8; shift >= 0; shift -= 8) {
+    asc.push_back(static_cast<uint8_t>(bits >> shift));
+  }
+  return asc;
+}
 
