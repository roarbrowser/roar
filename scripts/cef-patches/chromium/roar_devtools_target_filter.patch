+// Roar: the per-launch token remote clients must present, as an X-Roar-Token
+// header or (WebSocket only) a roar_token= query parameter. Empty refuses all.
+// Read and written on the UI thread.
+std::string& RoarCdpToken() {
+  static base::NoDestructor<std::string> token;
+  return *token;
+}
+
+bool RoarTokenOk(const net::HttpServerRequestInfo& info) {
+  const std::string& want = RoarCdpToken();
+  std::string got = info.GetHeaderValue("x-roar-token");
+  size_t q = info.path.find("roar_token=");
+  if (got.empty() && q != std::string::npos && q > 0 &&
+      (info.path[q - 1] == '?' || info.path[q - 1] == '&')) {
+    got = info.path.substr(q + 11, info.path.find('&', q) - q - 11);
+  }
+  if (want.empty() || got.size() != want.size()) {
+    return false;
+  }
+  unsigned char diff = 0;  // Constant time.
+  for (size_t i = 0; i < want.size(); ++i) {
+    diff |= want[i] ^ got[i];
+  }
+  return diff == 0;
+}
 
