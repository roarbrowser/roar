+// Roar: the embedder's filter for the targets remote CDP clients may see.
+// Gets the target's WebContents (null when asking about a profile alone).
+bool (*g_roar_target_filter)(WebContents*, BrowserContext*) = nullptr;
+
 }  // namespace
 
+// Roar: set by cef/libcef/browser/chrome/roar_devtools_filter.cc.
+void RoarSetDevToolsTargetFilter(bool (*filter)(WebContents*,
+                                                BrowserContext*)) {
+  g_roar_target_filter = filter;
+}
+
+// Roar: false hides |host| from Target.* and the HTTP endpoints. Hosts
+// without a WebContents (service workers, the browser target) always pass.
+bool RoarDevToolsTargetAllowed(DevToolsAgentHost* host) {
+  WebContents* contents = host ? host->GetWebContents() : nullptr;
+  return !g_roar_target_filter || !contents ||
+         g_roar_target_filter(contents, contents->GetBrowserContext());
+}
+
+// Roar: false when remote clients may not open pages in |context|.
+bool RoarDevToolsContextAllowed(BrowserContext* context) {
+  return !g_roar_target_filter || !context ||
+         g_roar_target_filter(nullptr, context);
+}
