+// Roar: each tab lives in a frameless child window of the browser window, so
+// its own frame equals the page and window.outerHeight == innerHeight, a
+// headless tell. Pages get the parent (browser) window's frame instead.
+gfx::Rect RenderWidgetHostViewMac::GetBoundsInScreenWithoutTransform() {
+  NSWindow* parent = [[GetInProcessNSView() window] parentWindow];
+  if (parent) {
+    return gfx::ScreenRectFromNSRect([parent frame]);
+  }
+  return window_frame_in_screen_dip_;
+}
