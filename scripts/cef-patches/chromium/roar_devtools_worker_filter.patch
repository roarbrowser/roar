+// Roar: the filter, except that Roar's own pipe reaches every service worker
+// (extension badges, the site menu). Only workers: pages stay filtered for it.
+bool RoarAllowed(DevToolsSession* root, DevToolsAgentHost* host) {
+  return (host->GetType() == DevToolsAgentHost::kTypeServiceWorker &&
+          root->GetClient()->GetTypeForMetrics() == "RoarPipe") ||
+         RoarDevToolsTargetAllowed(host);
