diff --git a/cef/libcef/browser/chrome/roar_create_target.h b/cef/libcef/browser/chrome/roar_create_target.h
new file mode 100644
index 000000000..b8f935449
--- /dev/null
+++ b/cef/libcef/browser/chrome/roar_create_target.h
@@ -0,0 +1,20 @@
+// Roar: lets the embedder open CDP Target.createTarget pages as its own tabs.
+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_ROAR_CREATE_TARGET_H_
+#define CEF_LIBCEF_BROWSER_CHROME_ROAR_CREATE_TARGET_H_
+
+class GURL;
+
+namespace content {
+class WebContents;
+}
+
+namespace cef {
+
+// Asks the embedder's hook to open |url|; returns the new browser's
+// WebContents, or nullptr when no hook is set or it declined.
+content::WebContents* CreateTargetContents(const GURL& url);
+
+}  // namespace cef
+
+#endif  // CEF_LIBCEF_BROWSER_CHROME_ROAR_CREATE_TARGET_H_
diff --git a/cef/libcef/browser/chrome/roar_create_target.cc b/cef/libcef/browser/chrome/roar_create_target.cc
new file mode 100644
index 000000000..d8b5d7835
--- /dev/null
+++ b/cef/libcef/browser/chrome/roar_create_target.cc
@@ -0,0 +1,29 @@
+#include "cef/libcef/browser/chrome/roar_create_target.h"
+
+#include "cef/libcef/browser/browser_host_base.h"
+#include "url/gurl.h"
+
+namespace {
+// Returns the id of a browser opened for the URL, or 0 to decline.
+using RoarCreateTargetHook = int (*)(const char* url);
+RoarCreateTargetHook g_hook = nullptr;
+}  // namespace
+
+// Exported for the embedder, which finds it with dlsym.
+extern "C" __attribute__((visibility("default"))) void roar_set_create_target_hook(
+    RoarCreateTargetHook hook) {
+  g_hook = hook;
+}
+
+namespace cef {
+
+content::WebContents* CreateTargetContents(const GURL& url) {
+  if (!g_hook) {
+    return nullptr;
+  }
+  int id = g_hook(url.spec().c_str());
+  auto browser = id ? CefBrowserHostBase::GetBrowserForBrowserId(id) : nullptr;
+  return browser ? browser->GetWebContents() : nullptr;
+}
+
+}  // namespace cef
